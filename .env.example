# feathers_demo
APP_ENV=development
LOG_LEVEL=info
PORT=8000

# Platform token contract v2. Every route except /health, /version, /metrics, the
# docs and `auth: none` endpoints needs a bastion-signed EdDSA token whose `aud` is
# "feathers-demo" (X-Platform-Token, or Authorization: Bearer). DEMO_MODE=true only
# lets a request with NO token through, as anonymous (logged); an invalid token is
# always refused. Keep it false in production.
DEMO_MODE=false

# bastion's Ed25519 public key (set one). With neither, protected routes answer 503.
# BASTION_SIGNING_KEY_PUBLIC=<base64 SPKI DER public key>
# BASTION_PUBLIC_KEY_URL=https://bastion.example/api/public-key

# Requests per minute per caller (iss:sub), or per client address when anonymous.
RATE_LIMIT_PER_MINUTE=120

# Comma-separated allowed CORS origins (empty = no cross-origin access),
# e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Database. Leave unset to use a local SQLite file; set to a Postgres DSN in
# production, e.g. postgresql+asyncpg://user:pass@host/db
DATABASE_URL=
