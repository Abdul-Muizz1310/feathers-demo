# feathers_demo
APP_ENV=development
LOG_LEVEL=info
PORT=8000

# Platform-token auth. Demo mode (default) accepts every request. Set to false
# to enforce the X-Platform-Token AND per-endpoint `auth:` roles — this also
# requires a bastion public key below, otherwise enforcement fails open.
DEMO_MODE=true

# Bastion Ed25519 public key for verifying X-Platform-Token (set one of these).
# BASTION_SIGNING_KEY_PUBLIC=<base64 DER public key>
# BASTION_PUBLIC_KEY_URL=https://bastion.example/api/public-key

# Comma-separated allowed CORS origins (empty = no cross-origin access),
# e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Database. Leave unset to use a local SQLite file; set to a Postgres DSN in
# production, e.g. postgresql+asyncpg://user:pass@host/db
DATABASE_URL=
